---
import BaseLayout from '../layouts/BaseLayout.astro';
---
<BaseLayout title="Astro iframe replacement">
  <h1>Astro iframe replacement</h1>
  <p class="lead">Select the editor-only button over the iframe to update this exact native source block.</p>
  <iframe src="/embed-preview" title="Astro project status" width="560" height="220" loading="lazy" referrerpolicy="no-referrer" sandbox="allow-scripts"></iframe>
  <p>This surrounding Astro paragraph must remain unchanged after replacement.</p>
</BaseLayout>
