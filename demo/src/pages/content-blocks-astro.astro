---
import BaseLayout from '../layouts/BaseLayout.astro';
---
<BaseLayout title="Astro static content types">
  <h1>Astro static content types</h1>
  <p>Select this Astro insertion target.</p>
  <h2>Replaceable Astro heading</h2>
  <ul><li>First Astro item</li><li>Second Astro item</li></ul>
  <blockquote><p>Static Astro quote.</p></blockquote>
  <pre><code>const astro = true;</code></pre>
  <hr />
  <p>This surrounding Astro source stays unchanged.</p>
</BaseLayout>
