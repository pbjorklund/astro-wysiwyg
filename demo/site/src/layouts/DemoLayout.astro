---
const { frontmatter } = Astro.props;
---

<!doctype html>
<html lang="en">
  <head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width" />
    <title>{frontmatter.title} | astro-wysiwyg demo</title>
    <style is:global>
      :root {
        font-family: Inter, ui-sans-serif, system-ui, sans-serif;
        color: #e2e8f0;
        background: #07111f;
        font-synthesis: none;
      }

      * { box-sizing: border-box; }
      body { margin: 0; min-width: 320px; min-height: 100vh; background: #07111f; }
      body::before {
        position: fixed;
        inset: 0;
        z-index: -1;
        content: '';
        background:
          radial-gradient(circle at 76% 14%, rgb(14 165 233 / 18%), transparent 34%),
          radial-gradient(circle at 14% 78%, rgb(99 102 241 / 14%), transparent 30%);
      }

      header {
        display: flex;
        align-items: center;
        justify-content: space-between;
        width: min(1360px, calc(100% - 96px));
        height: 92px;
        margin: 0 auto;
        border-bottom: 1px solid #22324a;
      }

      .brand { display: flex; align-items: center; gap: 14px; font-weight: 750; letter-spacing: -.02em; }
      .mark {
        display: grid;
        width: 40px;
        height: 40px;
        place-items: center;
        color: #07111f;
        background: #38bdf8;
        border-radius: 12px;
        box-shadow: 0 0 32px rgb(56 189 248 / 25%);
      }
      .mark svg { width: 24px; height: 24px; }
      .mode { color: #7dd3fc; font-size: 14px; font-weight: 650; }

      main {
        display: grid;
        grid-template-columns: minmax(0, 1fr) 310px;
        gap: 72px;
        width: min(1200px, calc(100% - 96px));
        margin: 96px auto 0;
      }

      article { max-width: 760px; }
      .eyebrow { margin: 0 0 18px; color: #7dd3fc; font-size: 14px; font-weight: 750; letter-spacing: .12em; text-transform: uppercase; }
      article h1 { margin: 0 0 30px; color: #f8fafc; font-size: clamp(48px, 5.2vw, 76px); line-height: .98; letter-spacing: -.055em; }
      article p { margin: 0 0 32px; color: #cbd5e1; font-size: 25px; line-height: 1.55; letter-spacing: -.018em; }
      article :is(strong, b) { color: #f8fafc; font-weight: 800; text-decoration: none; }
      article h2 { margin: 54px 0 16px; color: #f8fafc; font-size: 22px; }
      article h2 + p { color: #94a3b8; font-size: 18px; }

      aside {
        align-self: start;
        padding: 26px;
        background: rgb(15 23 42 / 72%);
        border: 1px solid #334155;
        border-radius: 20px;
        box-shadow: 0 22px 70px rgb(0 0 0 / 22%);
      }
      aside h2 { margin: 0 0 20px; color: #f8fafc; font-size: 17px; }
      aside ol { display: grid; gap: 18px; margin: 0; padding: 0; list-style: none; counter-reset: steps; }
      aside li { display: grid; grid-template-columns: 30px 1fr; gap: 12px; color: #cbd5e1; font-size: 15px; line-height: 1.4; counter-increment: steps; }
      aside li::before {
        display: grid;
        width: 28px;
        height: 28px;
        place-items: center;
        color: #bae6fd;
        background: #0c4a6e;
        border-radius: 999px;
        content: counter(steps);
        font-size: 13px;
        font-weight: 750;
      }

      [data-astro-wysiwyg]:focus-visible { outline: 3px solid #38bdf8; outline-offset: 8px; }
      @media (max-width: 900px) {
        header, main { width: min(100% - 40px, 720px); }
        main { grid-template-columns: 1fr; margin-top: 56px; }
        aside { display: none; }
      }
    </style>
  </head>
  <body>
    <header>
      <div class="brand">
        <span class="mark" aria-hidden="true">
          <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.2">
            <path d="M12 20h9"/><path d="M16.5 3.5a2.1 2.1 0 0 1 3 3L8 18l-4 1 1-4Z"/>
          </svg>
        </span>
        <span>astro-wysiwyg</span>
      </div>
      <span class="mode">Source-backed page editor</span>
    </header>
    <main>
      <article>
        <p class="eyebrow">Launch notes</p>
        <slot />
      </article>
      <aside aria-label="Walkthrough steps">
        <h2>Edit without leaving the page</h2>
        <ol>
          <li>Click source-backed text</li>
          <li>Rewrite and format</li>
          <li>Save to Markdown</li>
          <li>Reload to verify</li>
        </ol>
      </aside>
    </main>
  </body>
</html>
