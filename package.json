{
  "name": "astro-wysiwyg",
  "version": "0.1.0",
  "description": "Edit rendered Astro and Markdown text in place and save it to source files during development.",
  "type": "module",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js"
    },
    "./client": {
      "types": "./dist/client.d.ts",
      "import": "./dist/client.js"
    },
    "./toolbar-app": {
      "types": "./dist/toolbar-app.d.ts",
      "import": "./dist/toolbar-app.js"
    }
  },
  "files": [
    "dist",
    "README.md"
  ],
  "scripts": {
    "build": "tsc -p tsconfig.json",
    "test": "npm run test:unit",
    "test:unit": "node --test --experimental-strip-types tests/*.test.ts",
    "test:e2e": "npm run build && playwright test",
    "test:coverage:server": "node -e \"require('node:fs').rmSync('.coverage', { recursive: true, force: true })\" && c8 --all --include=src/**/*.ts --exclude=src/client.ts --reporter=json --reports-dir=.coverage/server node --test --experimental-strip-types tests/*.test.ts",
    "test:coverage": "npm run test:coverage:server && npm run test:e2e && node tests/report-coverage.mjs",
    "check:unit": "npm run test:unit && npm run build",
    "check": "npm run test:coverage",
    "demo:dev": "npm run build && astro dev --root demo/site --host 127.0.0.1",
    "demo:record": "npm run build && node demo/record.mjs",
    "prepack": "npm run check:unit"
  },
  "keywords": [
    "astro",
    "wysiwyg",
    "contenteditable",
    "markdown"
  ],
  "license": "MIT",
  "engines": {
    "node": ">=18.17.1"
  },
  "peerDependencies": {
    "astro": ">=5.0.0 <7.0.0"
  },
  "dependencies": {
    "@astrojs/compiler": "^2.13.1",
    "sanitize-html": "2.17.5",
    "turndown": "^7.2.2"
  },
  "devDependencies": {
    "@playwright/test": "^1.60.0",
    "@types/istanbul-lib-coverage": "^2.0.6",
    "@types/node": "^24.10.0",
    "@types/sanitize-html": "^2.16.1",
    "@types/turndown": "^5.0.5",
    "astro": "^6.4.8",
    "c8": "^12.0.0",
    "happy-dom": "^20.11.0",
    "istanbul-lib-coverage": "^3.2.2",
    "istanbul-lib-report": "^3.0.1",
    "istanbul-reports": "^3.2.0",
    "typescript": "^5.9.3",
    "vite-plugin-istanbul": "^9.0.1"
  }
}
