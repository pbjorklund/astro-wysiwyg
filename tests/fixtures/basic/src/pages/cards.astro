---
import { readFileSync } from 'node:fs';

const source = readFileSync(new URL('../content/articles/example/index.md', import.meta.url), 'utf8');
function frontmatter(field: string): string {
  const value = new RegExp(`^${field}:\\s*["'](.*)["']$`, 'm').exec(source)?.[1];
  if (!value) throw new Error(`Missing ${field}`);
  return value;
}
const article = {
  data: {
    title: frontmatter('title'),
    description: frontmatter('description'),
  },
};
---
<html lang="en">
  <head><meta charset="utf-8" /><title>Rendered cards</title></head>
  <body>
    <main>
      <a href="/articles/example">
        <h2 class="card-title">{article.data.title}</h2>
        <p class="card-summary">{article.data.description}</p>
      </a>
    </main>
  </body>
</html>
