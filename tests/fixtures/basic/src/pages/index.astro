---
const dynamicText = 'Dynamic text stays source-safe';
---
<html lang="en">
  <head>
    <meta charset="utf-8" />
    <title>Astro WYSIWYG fixture</title>
    <style>
      .lead { color: rgb(18, 92, 61); font-family: serif; font-size: 24px; }
    </style>
  </head>
  <body>
    <main>
      <h1>Editable Astro page</h1>
      <p class="lead">Edit this text without losing its style.</p>
      <p>{dynamicText}</p>
      <a href="/article">Open the Markdown fixture</a>
    </main>
  </body>
</html>
